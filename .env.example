# Copy this file to .env and fill in your own MongoDB Atlas credentials.
# .env is gitignored and must never be committed.
#
# Atlas > Database > Connect > Drivers gives you the username and host.
# The password is the one created under Security > Database Access.
MONGODB_USERNAME="your_db_user"
MONGODB_PASSWORD="your_db_password"
MONGODB_URI="mongodb+srv://your_db_user:your_db_password@your-cluster.xxxxx.mongodb.net"

# Optional: resolvers used by scripts/test-mongodb.mjs to look up the SRV/TXT
# records. Some home routers answer SRV but drop TXT, which makes the driver
# hang; pointing these at a public resolver avoids that.
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"

# Required by the admin auth endpoints (api/admin/*). Signs the session cookie
# issued after login. Use a long random string; rotate it to sign every admin
# out at once. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SERVER-ONLY: never prefix this with VITE_, or it is inlined into the browser
# bundle. The same applies to MONGODB_URI above.
ADMIN_SESSION_SECRET="change_me_to_a_long_random_string"

# Optional: database name for the admin credential document.
# Defaults to 2akinostore.
# MONGODB_DB="2akinostore"

# Note: Atlas shard hosts (M0) require TLS on the first handshake. The server
# client sets tls:true explicitly; without it the mongodb@7 driver closes the
# socket and reports a misleading "connection <monitor> ... closed".
